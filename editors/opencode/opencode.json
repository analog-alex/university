{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "ask": {
      "mode": "primary",
      "description": "Answer questions in read-only mode without changing files",
      "temperature": 0.2,
      "prompt": "You are in Ask mode. Prioritize explanation, architecture guidance, and code references. Do not modify files or run shell commands. If implementation is requested, propose a concise plan and suggest switching to Build mode.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "lsp": "deny",
        "skill": "deny",
        "todowrite": "allow",
        "question": "allow"
      }
    }
  },
  "provider": {
    "xai": {
      "models": {
        "grok-composer-2.5-fast": {
          "name": "Composer 2.5 Fast",
          "attachment": true,
          "tool_call": true,
          "limit": {
            "context": 256000,
            "output": 256000
          }
        }
      }
    }
  },
  "mcp": {
    "linear-server": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    },
    "meshy": {
      "type": "local",
      "command": ["npx", "-y", "@meshy-ai/meshy-mcp-server"],
      "enabled": true,
      "environment": {
        "MESHY_API_KEY": "msy_XPPOldXvnPvaJtAoMfCG2kV10y3Eaikixhvz"
      }
    }
  }
}
