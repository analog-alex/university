// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-n": "project_panel::ToggleFocus",
      "ctrl-l": "agent::ToggleFocus",
      "shift shift": "file_finder::Toggle",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      // NvChad-style leader mappings
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f w": "pane::DeploySearch",
      "space f b": "tab_switcher::Toggle",

      // buffer/tab navigation
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem",
      "space x": "pane::CloseActiveItem",

      // alteranitve (kitty like)
      "ctrl-shift-a": "pane::ActivatePreviousItem",
      "ctrl-shift-d": "pane::ActivateNextItem",
      "ctrl-shift-w": "pane::CloseActiveItem",

      // lsp
      "g r": "editor::FindAllReferences",
      "g d": "editor::GoToDefinition",
      "g i": "editor::GoToImplementation",
      "space r n": "editor::Rename",
      "space c a": "editor::ToggleCodeActions",
      "space f m": "editor::Format",

      "ctrl-shift-f": "editor::Format",
      "ctrl-shift-b": "editor::ToggleInlayHints",

      // theme
      "space t h": "theme_selector::Toggle",

      // splits
      "space v": "pane::SplitRight",
      "space h": "pane::SplitDown",

      // comments
      "space /": "editor::ToggleComments",

      // AI
      "space a a": "agent::ToggleFocus",
      "space a m": "agent::ToggleModelSelector",
      "space a p": "agent::ToggleProfileSelector",
      "cmd-k": "assistant::InlineAssist",

      // override things
      "ctrl-n": "project_panel::ToggleFocus",
      "ctrl-l": "agent::ToggleFocus",
      "ctrl-shift-n": "project_panel::ToggleFocus",
      "ctrl-shift-l": "agent::ToggleFocus",
    },
  },
  {
    "context": "Editor && vim_mode == visual && !menu",
    "bindings": {
      "space /": "editor::ToggleComments",
      "cmd-k": "assistant::InlineAssist",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-shift-p": "editor::ShowEditPrediction",
      "ctrl-shift-y": "editor::AcceptEditPrediction",
      "ctrl-shift-o": "editor::AcceptPartialEditPrediction",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "space e": "workspace::ActivatePreviousPane",
      "ctrl-n": "workspace::ToggleRightDock",
      "ctrl-shift-n": "project_panel::ToggleFocus",
      "ctrl-shift-q": "workspace::ToggleLeftDock",
      "ctrl-shift-a": "project_panel::NewFile",
      "ctrl-shift-f": "project_panel::NewDirectory",
      "ctrl-shift-r": "project_panel::Rename",
      "ctrl-shift-d": "project_panel::Delete",
      "ctrl-shift-y": "project_panel::Copy",
      "ctrl-shift-x": "project_panel::Cut",
      "ctrl-shift-p": "project_panel::Paste",
    },
  },
  {
    "context": "AssistantPanel || ContextEditor || AgentPanel",
    "bindings": {
      "space a a": "workspace::ActivatePreviousPane",
      "ctrl-l": "workspace::ToggleRightDock",
      "ctrl-shift-l": "agent::ToggleFocus",
      "escape": "workspace::ActivatePreviousPane",
    },
  },
  {
    "context": "Dock || Terminal || Panel",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
    },
  },
]
